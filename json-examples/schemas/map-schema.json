{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map metadata requirements",
  "allOf": [{ "$ref": "common-baseline.json" }],
  "type": "object",
  "required": ["maplayers"],
  "properties": {
    "maplayers": {
      "type": "array",
      "minItems": 1,
      "description": "a map must reference its datasets as maplayers",
      "items": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "object",
            "required": ["pk"],
            "description": "the maplayer must resolve to a real dataset, not a dangling name"
          }
        }
      }
    }
  }
}
